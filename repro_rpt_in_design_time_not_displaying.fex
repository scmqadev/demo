ENGINE INT CACHE SET ON
SET PAGE-NUM=NOLEAD
SET SQUEEZE=ON
-DEFAULTH &WF_HTMLENCODE=ON;
SET HTMLENCODE=&WF_HTMLENCODE

SET HTMLCSS=ON
-DEFAULTH &WF_EMPTYREPORT=ON;
SET EMPTYREPORT=&WF_EMPTYREPORT

SET EMBEDHEADING=ON
SET GRAPHDEFAULT=OFF

SET ARVERSION=2
-DEFAULTH &WF_SUMMARY='Summary';
-DEFAULTH &WF_TITLE='WebFOCUS Report';

-*COMPONENT=Define_wf_retail_product
DEFINE FILE wfretail82/dimensions/wf_retail_product
 IDT_PI_Prospect_CALC/P20 ( TITLE = 'Identifiant du tiers Prospect CALC', MISSING ='ON' ) =5;
 IDT_PI_Client_CALC/D12.2 ( TITLE = 'Identifiant du tiers Client CALC', MISSING ='ON' ) =4;
 TopTiersProspect_CALC/I1C ( TITLE = 'TopTiersProspectCALC' ) =3;
 TopTiersClient_CALC/I1C ( TITLE = 'TopTiersClient CALC' ) =2;
 Cpt_CALC/I1C ( TITLE = 'Cpt Lignes CALC' ) =1;
END
TABLE FILE wfretail82/dimensions/wf_retail_product
SUM CNT.DST.WF_RETAIL_PRODUCT.WF_RETAIL_PRODUCT.PRODUCT_NAME AS 'Nbr de,clients'
CNT.DST.WF_RETAIL_PRODUCT.WF_RETAIL_PRODUCT.BRAND AS 'En statut,Client'
TopTiersClient_CALC AS 'TopTiersClient,CALC SUM' NOPRINT
CNT.DST.IDT_PI_Prospect_CALC AS 'En statut,Prospect'
SUM.TopTiersProspect_CALC/I1C AS 'TopTiersProspect,CALC SUM' NOPRINT
COMPUTE VerifTotalNbCliEtNbPro/I5C=10; AS 'test1' NOPRINT
COMPUTE Diff_NbClients/I5C=10; AS 'test2'
COMPUTE Diff_NbClients_MISSING/I5C=10; AS 'test3' NOPRINT
COMPUTE Diff_INCREASE/I5C=10; AS 'test4' NOPRINT
COMPUTE Diff_PARTITION_REF/I5C=10; AS 'test5' NOPRINT
COMPUTE Diff_PREVIOUS/I5C=10; AS 'test6' NOPRINT
COMPUTE Diff_PARTITION_AGGR/I5C=10; AS 'test7' NOPRINT
COMPUTE Diff_NbClients_Affiche0/I5C=10; AS 'test8' NOPRINT
COMPUTE Diff_NbClients_DifPeriode/I5C=10; AS 'test9' NOPRINT
COMPUTE Evolution_NbClients/D12.2p=10; AS 'test10'
COMPUTE Evolution_NbClients_MISSING/D12.2p=10; AS 'test11' NOPRINT
COMPUTE Evolution_PCT_INCREASE/D12.2p=10; AS 'test12' NOPRINT
COMPUTE Evolution_PARTITION_REF/D12.2p=10; AS 'test13' NOPRINT
COMPUTE Evolution_PARTITION_AGGR/D12.2p= 10; AS 'test14' NOPRINT
BY WF_RETAIL_PRODUCT.WF_RETAIL_PRODUCT.PRODUCT_NAME AS 'product name'
BY WF_RETAIL_PRODUCT.WF_RETAIL_PRODUCT.BRAND AS 'brand'
ACROSS WF_RETAIL_PRODUCT.WF_RETAIL_PRODUCT.BRANDTYPE
HEADING
"EXO24 - test report"
ON TABLE PCHOLD FORMAT HTML
ON TABLE NOTOTAL
ON TABLE SET POPUPDESC ON
ON TABLE SET CACHELINES 100
ON TABLE SET BYDISPLAY BY
ON TABLE SET AUTOFIT OFF
ON TABLE SET VZERO OFF
ON TABLE SET STYLE *
INCLUDE=IBFS:/WFC/Global/Themes/Standard/Default/theme.sty,$
DEFMACRO=test, MACTYPE=RULE, WHEN=N8 NE PRODUCT_NAME, $
TYPE=REPORT, TITLETEXT=&WF_TITLE.QUOTEDSTRING, SUMMARY=&WF_SUMMARY.QUOTEDSTRING, ARREPORTSIZE=DIMENSION, ARFILTER_TARGET='*', ARGRAPHENGINE=JSCHART, $
TYPE=DATA, ACROSSCOLUMN=N1, MACRO=test, FONT='LUCIDA SANS UNICODE', COLOR=RGB(237 28 36), HYPERLINK-COLOR=RGB(237 28 36), $
ENDSTYLE
END






